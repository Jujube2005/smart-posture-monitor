# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python local/build artifacts
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
**/build/
**/dist/
**/.pio/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
.envrc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
!.env.*.example

# local ESP8266 credentials
secrets.h
**/secrets.h

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
